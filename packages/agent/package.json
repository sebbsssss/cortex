{
  "name": "@cortex/agent",
  "version": "0.2.0",
  "description": "Cortex - Self-learning AI agent with persistent memory, dream cycles, and on-chain proofs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./dreams": {
      "types": "./dist/dreams/dream-cycle.d.ts",
      "import": "./dist/dreams/dream-cycle.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "demo": "tsx src/demo.ts",
    "demo:memory": "tsx src/demo-memory.ts",
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "agent",
    "solana",
    "self-learning",
    "autonomous",
    "reflexion",
    "memory",
    "cognitive-architecture"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  }
}
